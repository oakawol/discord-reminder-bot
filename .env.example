DISCORD_TOKEN=your_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_server_id_here  # Optional: For instant guild command updates

# AI Provider API Keys (At least one is required for AI chat)
GEMINI_API_KEY=your_gemini_api_key_here  # Google Gemini API key (https://aistudio.google.com)
GEMINI_MODEL=gemini-3.5-flash-lite  # Casual & daily banter tier
GEMINI_COMPLEX_MODEL=gemini-4-hydrogen  # Frontier intelligence tier for complex coding & deep reasoning
TAVILY_API_KEY=tvly-your_tavily_api_key_here  # Tavily AI Search (https://tavily.com - 1000 free searches/mo)
GROQ_API_KEY=gsk_your_groq_api_key_here  # Primary ultra-fast LLM provider (https://console.groq.com)
OPENROUTER_API_KEY=your_openrouter_api_key_here  # Optional fallback (https://openrouter.ai)
CEREBRAS_API_KEY=your_cerebras_api_key_here  # Optional fallback (https://cerebras.ai)
POLLINATIONS_API_KEY=your_pollinations_api_key_here  # Optional fallback (https://pollinations.ai)

